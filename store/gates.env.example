# Copy these names into GitHub → Settings → Variables (Actions).
# Missing or false = off. Values other than true/false/yes/no/on/off/1/0 fail the iOS run.

# --- iOS (ios-v* tags; .github/workflows/ios-release.yml) ---
# Master switch: when off, no iOS store operation runs (the GitHub Release is still created).
IOS_RELEASE_AUTOMATION=false
# Build, sign and upload the binary to App Store Connect.
IOS_UPLOAD_BUILD=false
# Description, keywords, promotional text, marketing/support URLs.
IOS_UPLOAD_LISTING=false
# What's New text for the version.
IOS_UPLOAD_WHATS_NEW=false
# 6.7" App Store screenshots.
IOS_UPLOAD_SCREENSHOTS=false
# Select this run's processed build and submit for App Review (needs IOS_UPLOAD_BUILD).
IOS_SUBMIT_REVIEW=false
# true = release automatically after approval; false = you release it by hand.
IOS_PUBLIC_RELEASE=false
# Build readiness polling (defaults shown).
IOS_BUILD_POLL_SECONDS=30
IOS_BUILD_WAIT_MINUTES=120

# --- Android (android-v* tags; .github/workflows/android-release.yml) ---
STORE_UPLOAD_WHATS_NEW=false
STORE_UPLOAD_LISTING=false
STORE_UPLOAD_SCREENSHOTS=false
# Publishes this build to Play production, live. Stay off.
STORE_PRODUCTION_ROLLOUT=false

# --- Shared ---
# When true, release workflows fail closed — RevenueCat write/sync is not implemented.
STORE_SYNC_REVENUECAT=false
