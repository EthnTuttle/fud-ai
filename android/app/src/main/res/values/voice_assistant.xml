    <string name="voice_notice_setup_title">Set up the voice assistant</string>
    <string name="voice_notice_setup_body">Talk with Fud AI on a Plus or Pro plan, or add your own Gemini, OpenAI or xAI key in AI Providers.</string>
    <string name="voice_notice_missing_key_title">Add your %1$s key</string>
    <string name="voice_notice_missing_key_body">The voice assistant is set to %1$s, which needs your API key. Add it in AI Providers, or choose another provider in Voice Assistant settings.</string>
    <string name="voice_notice_subscription_title">Plus or Pro needed</string>
    <string name="voice_notice_subscription_body">Voice hosted by Fud AI comes with Plus (20 minutes a month) and Pro (100 minutes a month). You can also use your own Gemini, OpenAI or xAI key.</string>
    <string name="voice_notice_minutes_title">Out of voice minutes</string>
    <string name="voice_notice_minutes_body">You’ve used this month’s voice minutes. Credits add more time (4 credits a minute), or you can switch to your own key in Voice Assistant settings.</string>
    <string name="voice_notice_limit_title">Conversation limit reached</string>
    <string name="voice_notice_limit_body">A conversation can last up to 15 minutes. Start a new one to keep talking.</string>
    <string name="voice_notice_mic_title">Microphone access needed</string>
    <string name="voice_notice_mic_body">Allow Fud AI to use the microphone in system settings to talk with the assistant.</string>
    <string name="voice_notice_mic_busy_title">Microphone unavailable</string>
    <string name="voice_notice_mic_busy_body">Another app may be using the microphone. Close it and try again.</string>
    <string name="voice_notice_key_rejected_title">%1$s rejected the key</string>
    <string name="voice_notice_key_rejected_body">Check your %1$s API key, its billing and its access to live voice models in AI Providers.</string>
    <string name="voice_notice_unauthorized_title">Couldn’t verify your plan</string>
    <string name="voice_notice_unauthorized_body">Fud AI couldn’t identify your subscription. Try again, or use Restore Purchases in Settings → AI Access.</string>
    <string name="voice_notice_busy_title">Too many requests</string>
    <string name="voice_notice_busy_body">The voice assistant is busy right now. Wait a moment and try again.</string>
    <string name="voice_notice_unavailable_title">Voice is unavailable</string>
    <string name="voice_notice_unavailable_body">The voice service is temporarily unavailable. Please try again shortly.</string>
    <string name="voice_notice_connect_title">Couldn’t connect</string>
    <string name="voice_notice_connect_body">Check your internet connection and try again.</string>
    <string name="voice_notice_lost_title">Conversation ended</string>
    <string name="voice_notice_lost_body">The connection was lost. Start again to keep talking.</string>

