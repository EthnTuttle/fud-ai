    <string name="voice_settings_needs_setup">Subscribe to Plus or Pro, or add a Gemini, OpenAI or xAI key</string>
    <string name="voice_settings_automatic_footer">Automatic uses your selected AI provider when it has a saved key and live voice, then Fud AI Plus/Pro, then any other saved key. Gemini and Fud AI watch the open camera, OpenAI gets a photo with each turn, and xAI can’t see the camera.</string>
    <string name="voice_settings_auto_capture">Auto-Capture Photos</string>
    <string name="voice_settings_auto_capture_footer">When the camera is open, the assistant takes the photo as soon as the food is clearly in view.</string>
    <string name="voice_settings_confirm_saves">Confirm Before Saving</string>
    <string name="voice_settings_confirm_saves_footer">Show a card to approve each log or change. When off, changes save right away with an 8-second Undo.</string>
    <string name="voice_settings_save_to_coach">Save Conversations to Coach</string>
    <string name="voice_settings_save_to_coach_footer">Add what you and the assistant say to your Coach chat history.</string>
    <string name="voice_settings_minutes_left">Voice Minutes Left</string>
    <string name="voice_settings_minutes_unknown" translatable="false">—</string>
    <string name="voice_settings_minutes_with_credits">%1$s + %2$s from credits</string>
    <string name="voice_settings_minutes_footer">Plus includes 20 voice minutes a month and Pro 100 (UTC calendar month). After that, each minute uses 4 credits. Time is counted in 15-second blocks.</string>
    <string name="voice_settings_open_title">Open It From Anywhere</string>
    <string name="voice_settings_open_body">Tap the orb on Home, add the Talk to Fud AI tile to Quick Settings, long-press the app icon and choose Talk to Fud AI, or add the widget to your home screen. Each one starts listening right away.</string>
    <string name="voice_settings_add_tile">Add Quick Settings Tile</string>
    <string name="voice_settings_add_widget">Add Home Screen Widget</string>
    <string name="voice_settings_privacy_footer">Your voice, captions, the camera frames the assistant sees and the results of its actions go to the provider you use (Google for Fud AI Plus/Pro). Fud AI’s server records only the seconds used.</string>
