    "Opens Fud AI and starts a voice conversation with the assistant." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يفتح Fud AI ويبدأ محادثة صوتية مع المساعد."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fud AI-ı açır və köməkçi ilə səsli söhbət başladır."
